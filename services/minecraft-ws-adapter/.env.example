# WebSocket in the team's Open-LLM-VTuber (only local for MVP)
PROXY_WS_URL=ws://127.0.0.1:12393/proxy-ws?mode=game
# Paste the same randomly generated secret into MINECRAFT_WS_TOKEN on the Python server.
MINECRAFT_WS_TOKEN=REPLACE_WITH_A_RANDOM_LONG_SECRET
# MCPFabric Streamable HTTP endpoint; Minecraft bridge port 25599 is NOT this.
MCP_URL=http://127.0.0.1:25600/mcp
# 0 = send state only when requested; optional seconds between automatic pushes (milliseconds)
STATE_INTERVAL_MS=0
# OFF by default; use only on a private test world and enable on server too.
ALLOW_MOVEMENT=false
